private noncomputable def psi2SqMv : MvPolynomial (Fin 2) ℚ :=
  4 * (X 1) ^ 3
    - 4 * (X 0) ^ 3 * (X 1)
    + 12 * (X 0) ^ 2 * (X 1)
    + 4 * (X 0) ^ 5
    - 23 * (X 0) ^ 4
    - 18 * (X 0) ^ 3
    + (X 0) ^ 2
    - 4 * (X 0)


/-- Abstract short-Weierstrass formula for `Φ₃` as a multivariate identity. -/
private theorem phi3Mv_formula :
    phi3Mv = (X 1) * psi3Mv ^ 2 - prePsi4Mv * psi2SqMv := by
  unfold phi3Mv psi3Mv prePsi4Mv psi2SqMv
  ring

private theorem bezout_identity_mv :
    bezoutUMv * phi3Mv + bezoutVMv * psi3Mv = bezoutDMv := by
  unfold bezoutUMv phi3Mv bezoutVMv psi3Mv bezoutDMv
  ring

private theorem bezoutDMv_ne_zero : bezoutDMv ≠ 0 := by
  intro h
  have h1 := congrArg (eval (![1, 0] : Fin 2 → ℚ)) h
  rw [map_zero, bezoutDMv] at h1
  simp at h1
  norm_num at h1

/-- Substitution `X 0 ↦ C z`, `X 1 ↦ X` into `ℚ(z)[X]`. -/
private noncomputable def sigmaQ : Fin 2 → Polynomial KQ :=
  ![Polynomial.C (RatFunc.X : KQ), Polynomial.X]

private noncomputable def evalQ : MvPolynomial (Fin 2) ℚ →ₐ[ℚ] Polynomial KQ :=
  aeval sigmaQ

private theorem four_ne_zero_KQ : (4 : KQ) ≠ 0 := by norm_num

private theorem noteCurveQ_b₂ : noteCurveQ.b₂ = 0 := by
  simp [WeierstrassCurve.b₂, noteCurveQ]

private theorem noteCurveQ_b₄ : noteCurveQ.b₄ = 2 * noteCurveQ.a₄ := by
  simp [WeierstrassCurve.b₄, noteCurveQ]

private theorem noteCurveQ_b₆ : noteCurveQ.b₆ = 4 * noteCurveQ.a₆ := by
  simp [WeierstrassCurve.b₆, noteCurveQ]

private theorem noteCurveQ_b₈ : noteCurveQ.b₈ = -noteCurveQ.a₄ ^ 2 := by
  simp only [WeierstrassCurve.b₈, noteCurveQ]
  ring

/-- Expand `evalQ` of a multivariate certificate. -/
private theorem evalQ_expand (p : MvPolynomial (Fin 2) ℚ) :
    evalQ p = aeval (![Polynomial.C (RatFunc.X : KQ), Polynomial.X] : Fin 2 → Polynomial KQ) p :=
  rfl

private theorem noteCurveQ_Ψ₃_eq : noteCurveQ.Ψ₃ = evalQ psi3Mv := by
  -- Expand the certificate first (no divisions).
  have hrhs :
      evalQ psi3Mv =
        (3 : Polynomial KQ) * Polynomial.X ^ 4
          + Polynomial.C (-(6 : KQ) * RatFunc.X ^ 3 + 18 * RatFunc.X ^ 2) * Polynomial.X ^ 2
          + Polynomial.C
              ((12 : KQ) * RatFunc.X ^ 5 - 69 * RatFunc.X ^ 4 - 54 * RatFunc.X ^ 3
                + 3 * RatFunc.X ^ 2 - 12 * RatFunc.X) * Polynomial.X
          + Polynomial.C (-(RatFunc.X : KQ) ^ 6 + 6 * RatFunc.X ^ 5 - 9 * RatFunc.X ^ 4) := by
    unfold psi3Mv evalQ sigmaQ
    simp only [map_add, map_sub, map_mul, map_pow, map_neg, aeval_X, map_ofNat,
      Matrix.cons_val_zero, Matrix.cons_val_one]
    ring
  rw [hrhs]
  -- Expand Mathlib's `Ψ₃` for the short model and clear the `/4` in `a₆`.
  rw [WeierstrassCurve.Ψ₃, noteCurveQ_b₂, noteCurveQ_b₄, noteCurveQ_b₆, noteCurveQ_b₈]
  simp only [noteCurveQ, noteP]
  field_simp [four_ne_zero_KQ]
  -- Pull scalar factors into `Polynomial.C` and drop zero terms.
  simp only [← map_ofNat (f := Polynomial.C), ← Polynomial.C_mul, Polynomial.C_0, zero_mul,
    add_zero]
  ring_nf

private theorem noteCurveQ_preΨ₄_eq : noteCurveQ.preΨ₄ = evalQ prePsi4Mv := by
  rw [WeierstrassCurve.preΨ₄, noteCurveQ_b₂, noteCurveQ_b₄, noteCurveQ_b₆, noteCurveQ_b₈]
  simp only [noteCurveQ, noteP]
  field_simp [four_ne_zero_KQ]
  unfold prePsi4Mv evalQ sigmaQ
  simp only [map_add, map_sub, map_mul, map_pow, map_neg, aeval_X, map_ofNat, map_one,
    Matrix.cons_val_zero, Matrix.cons_val_one]
  ring_nf
  simp only [Polynomial.C_0, mul_zero, zero_mul, add_zero, zero_add, sub_zero, neg_zero]

private theorem noteCurveQ_Ψ₂Sq_eq : noteCurveQ.Ψ₂Sq = evalQ psi2SqMv := by
  rw [WeierstrassCurve.Ψ₂Sq, noteCurveQ_b₂, noteCurveQ_b₄, noteCurveQ_b₆]
  simp only [noteCurveQ, noteP]
  field_simp [four_ne_zero_KQ]
  unfold psi2SqMv evalQ sigmaQ
  simp only [map_add, map_sub, map_mul, map_pow, aeval_X, map_ofNat, map_one,
    Matrix.cons_val_zero, Matrix.cons_val_one]
  ring_nf
  simp only [Polynomial.C_0, mul_zero, add_zero]

private theorem evalQ_X1 : evalQ (X 1) = Polynomial.X := by
  simp [evalQ, sigmaQ, aeval_X]

private theorem noteCurveQ_Φ_eq : noteCurveQ.Φ 3 = evalQ phi3Mv := by
  have hΦ : noteCurveQ.Φ 3 =
      Polynomial.X * noteCurveQ.Ψ₃ ^ 2 - noteCurveQ.preΨ₄ * noteCurveQ.Ψ₂Sq :=
    WeierstrassCurve.Φ_three (W := noteCurveQ)
  rw [hΦ, noteCurveQ_Ψ₃_eq, noteCurveQ_preΨ₄_eq, noteCurveQ_Ψ₂Sq_eq, phi3Mv_formula]
  simp only [map_sub, map_mul, map_pow, evalQ_X1]

private noncomputable def bezoutDQ : KQ :=
  186624 * RatFunc.X ^ 20 - 4347648 * RatFunc.X ^ 19 + 34799968 * RatFunc.X ^ 18
    - 92402928 * RatFunc.X ^ 17 - 82179495 * RatFunc.X ^ 16 + 376575912 * RatFunc.X ^ 15
    + 581293692 * RatFunc.X ^ 14 + 397021608 * RatFunc.X ^ 13 + 325092150 * RatFunc.X ^ 12
    + 221014440 * RatFunc.X ^ 11 + 81979452 * RatFunc.X ^ 10 + 45682056 * RatFunc.X ^ 9
    + 20832633 * RatFunc.X ^ 8 + 1761264 * RatFunc.X ^ 7 + 3429216 * RatFunc.X ^ 6
    - 186624 * RatFunc.X ^ 5 + 186624 * RatFunc.X ^ 4

private theorem evalQ_bezoutD : (evalQ bezoutDMv : Polynomial KQ) = Polynomial.C bezoutDQ := by
  unfold evalQ sigmaQ bezoutDMv bezoutDQ
  simp only [map_add, map_sub, map_mul, map_pow, aeval_X, map_ofNat, Matrix.cons_val_zero]

private theorem bezoutDQ_ne_zero : bezoutDQ ≠ 0 := by
  -- Image of a nonzero element of `ℚ[z]` under the injective map into `ℚ(z)`.
  set p : Polynomial ℚ :=
    186624 * Polynomial.X ^ 20 - 4347648 * Polynomial.X ^ 19 + 34799968 * Polynomial.X ^ 18
      - 92402928 * Polynomial.X ^ 17 - 82179495 * Polynomial.X ^ 16
      + 376575912 * Polynomial.X ^ 15 + 581293692 * Polynomial.X ^ 14
      + 397021608 * Polynomial.X ^ 13 + 325092150 * Polynomial.X ^ 12
      + 221014440 * Polynomial.X ^ 11 + 81979452 * Polynomial.X ^ 10
      + 45682056 * Polynomial.X ^ 9 + 20832633 * Polynomial.X ^ 8
      + 1761264 * Polynomial.X ^ 7 + 3429216 * Polynomial.X ^ 6
      - 186624 * Polynomial.X ^ 5 + 186624 * Polynomial.X ^ 4 with hp_def
  have h20 : p.coeff 20 = (186624 : ℚ) := by
    simp [p, Polynomial.coeff_X_pow]
  have hp : p ≠ 0 := fun h =>
    (by norm_num : (186624 : ℚ) ≠ 0) (h20 ▸ congrArg (fun q : Polynomial ℚ => q.coeff 20) h)
  have h : bezoutDQ = algebraMap (Polynomial ℚ) KQ p := by
    simp only [bezoutDQ, p, map_add, map_sub, map_mul, map_pow, map_ofNat, RatFunc.algebraMap_X]
  rw [h]
  simpa [map_zero] using (FaithfulSMul.algebraMap_injective (Polynomial ℚ) KQ).ne hp

private theorem isCoprime_Φ_Ψ₃_noteCurveQ :
    IsCoprime (noteCurveQ.Φ 3) noteCurveQ.Ψ₃ := by
  rw [noteCurveQ_Φ_eq, noteCurveQ_Ψ₃_eq]
  refine ⟨(evalQ bezoutUMv) * Polynomial.C bezoutDQ⁻¹,
    (evalQ bezoutVMv) * Polynomial.C bezoutDQ⁻¹, ?_⟩
  have hid :
      (evalQ bezoutUMv) * (evalQ phi3Mv) + (evalQ bezoutVMv) * (evalQ psi3Mv)
        = evalQ bezoutDMv := by
    simpa [← map_mul, ← map_add] using
      congrArg (AlgHom.toRingHom evalQ) bezout_identity_mv
  have hD : bezoutDQ ≠ 0 := bezoutDQ_ne_zero
  calc
    (evalQ bezoutUMv) * Polynomial.C bezoutDQ⁻¹ * (evalQ phi3Mv)
        + (evalQ bezoutVMv) * Polynomial.C bezoutDQ⁻¹ * (evalQ psi3Mv)
      = Polynomial.C bezoutDQ⁻¹
          * ((evalQ bezoutUMv) * (evalQ phi3Mv) + (evalQ bezoutVMv) * (evalQ psi3Mv)) := by
        ring
    _ = Polynomial.C bezoutDQ⁻¹ * evalQ bezoutDMv := by rw [hid]
    _ = Polynomial.C bezoutDQ⁻¹ * Polynomial.C bezoutDQ := by rw [evalQ_bezoutD]
    _ = Polynomial.C (bezoutDQ⁻¹ * bezoutDQ) := by rw [← Polynomial.C_mul]
    _ = Polynomial.C 1 := by rw [inv_mul_cancel₀ hD]
    _ = 1 := by simp

/-- **Coprimality of `Φ₃` and `ΨSq₃` for the model (3.7).** -/
public theorem isCoprime_Φ_ΨSq_noteCurveQ :
    IsCoprime (noteCurveQ.Φ 3) (noteCurveQ.ΨSq 3) := by
  simpa [WeierstrassCurve.ΨSq_three] using
    (isCoprime_Φ_Ψ₃_noteCurveQ.pow_right (n := 2))

private theorem three_ne_zero_KQ : (3 : KQ) ≠ 0 := by
  exact_mod_cast (three_ne_zero : (3 : ℚ) ≠ 0)

/-- **Unconditional degree-nine statement for the model (3.7).**

The `x`-line over `ℚ(z)` is a degree-exactly-`9` extension of the subfield generated by
`x ∘ [3]`. -/
public theorem finrank_mulThreeX_noteCurveQ :
    Module.finrank KQ⟮mulThreeX noteCurveQ⟯ (RatFunc KQ) = 9 :=
  finrank_mulThreeX noteCurveQ three_ne_zero_KQ isCoprime_Φ_ΨSq_noteCurveQ

/-! ## Axiom audit -/

#print axioms isCoprime_Φ_ΨSq_noteCurveQ
#print axioms finrank_mulThreeX_noteCurveQ

end ExplicitUnirational
